APP_NAME=MySchool
APP_ENV=production
# Isi dengan: php artisan key:generate (jalankan di server, jangan pakai key lokal)
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI-DENGAN-ALAMAT-WEB-ASLI

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myschool
# Buat user khusus, jangan pakai root
DB_USERNAME=GANTI-USER-KHUSUS
DB_PASSWORD=GANTI-PASSWORD-KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=GANTI
MAIL_PASSWORD=GANTI
MAIL_FROM_ADDRESS="GANTI@contoh.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

SCHOOL_NAME="GANTI"
SCHOOL_TAGLINE="GANTI"
SCHOOL_PHONE="GANTI"
SCHOOL_WHATSAPP="GANTI"
SCHOOL_EMAIL="GANTI"
SCHOOL_ADDRESS="GANTI"
SCHOOL_INSTAGRAM=

# Versi coba: true hanya di web demo, jangan di web asli
DEMO_MODE=false
FEEDBACK_URL=
